# ─── SentinelAI Environment Configuration ─────────────────────────────────
# Copy this file to .env and adjust values as needed.

# Application
APP_NAME=SentinelAI
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Database
# SQLite (default for development):
DATABASE_URL=sqlite+aiosqlite:///./sentinelai.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://sentinelai:password@localhost:5432/sentinelai

# CORS - comma-separated allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Security
SECRET_KEY=change-this-to-a-strong-random-key-in-production
GOOGLE_CLIENT_ID=631202073591-i7kjpj9nplmus7fuivr0scfp3t41knjt.apps.googleusercontent.com

# ML
ML_MODEL_PATH=./ml/artifacts

# Dataset
DATASET_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed

# Replay Engine
DEFAULT_REPLAY_SPEED=1.0
MAX_REPLAY_SPEED=10.0
REPLAY_BATCH_SIZE=100

# Alert Thresholds
ALERT_RISK_THRESHOLD=50.0
CRITICAL_RISK_THRESHOLD=75.0
