# ─── SentinelAI Backend Environment Template ──────────────────────────────
APP_NAME=SentinelAI
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./sentinelai.db

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Security & OAuth
SECRET_KEY=change-this-to-a-strong-random-key-in-production
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ML & Artifacts
ML_MODEL_PATH=./ml/artifacts
DATASET_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed

# Alert Thresholds
ALERT_RISK_THRESHOLD=50.0
CRITICAL_RISK_THRESHOLD=75.0
